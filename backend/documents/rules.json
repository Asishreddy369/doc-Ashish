            "Master Services Agreement",
            "Non-Disclosure Agreement"
        ]
    },
    {
        "id": "rule_gst_regex_01",
        "category": "GST Certificate",
        "priority": 4,
        "type": "regex",
        "patterns": [
            "\\bGSTR\\s*[-_ ]?(?:1|2B|3B)\\b",
            "\\bGST\\s*(?:Certificate|Registration|Challan|Return)\\b",
            "\\bGoods\\s+and\\s+Services\\s+Tax\\s+(?:Certificate|Registration)\\b"
        ]
    },
    {
        "id": "rule_gst_01",
        "category": "GST Certificate",
        "priority": 5,
        "type": "keyword",
        "patterns": [
            "Goods and Services Tax",
            "GSTR1",
            "GSTR2B",
            "GSTR3B",
            "GST CHALLAN"
        ]
    },
    {
        "id": "rule_bank_stmt_name_01",
        "category": "Bank Statement",
        "priority": 8,
        "type": "keyword",
        "patterns": [
            "Account Statement",
            "Acct Statement",
            "Acct_Statement",
            "Bank Statement",
            "Bank_Statement"
        ]
    },
    {
        "id": "rule_tax_challan_01",
        "category": "Tax Filing",
        "priority": 9,
        "type": "regex",
        "patterns": [
            "\\A(?:filename:)?[^\\n]*ChallanReceipt",
            "\\A(?:filename:)?[^\\n]*ChallanForm",
            "\\A(?:filename:)?[^\\n]*Form[\\s_\\-]*26Q",
            "\\bChallan\\s*(?:Receipt|Form)\\b",
            "\\b(?:SBIN|HDFC)_?ChallanReceipt\\b",
            "\\bForm\\s*26Q\\b",
            "\\bTax\\s+(?:Challan|Payment|Deducted|Deposited)\\b"
        ]
    },
    {
        "id": "rule_pan_name_01",
        "category": "PAN",
        "priority": 10,
        "type": "regex",
        "patterns": [
            "\\A(?:filename:)?[^\\n]*\\bPAN\\b[^\\n]*",
            "\\A(?:filename:)?[^\\n]*Permanent[\\s_\\-]+Account[\\s_\\-]+Number[^\\n]*",
            "\\A(?:filename:)?[^\\n]*Income[\\s_\\-]+Tax[\\s_\\-]+Department[^\\n]*"
        ]
    },
    {
        "id": "rule_pan_regex_01",
        "category": "PAN",
        "priority": 12,
        "type": "regex",
        "patterns": [
            "\\A(?:filename:)?[^\\n]*\\b[A-Z]{5}[0-9]{4}[A-Z]{1}\\b[^\\n]*",
            "\\bIncome Tax Department\\b[\\s\\S]{0,220}\\b[A-Z]{5}[0-9]{4}[A-Z]{1}\\b"
        ]
    },
    {
        "id": "rule_aadhaar_name_01",
