[
    {
        "id": "rule_archive_name_01",
        "category": "Archive",
        "priority": 1,
        "type": "regex",
        "patterns": [
            "\\A(?:filename:)?[^\\n]*\\.(?:zip|jar|rar)\\b"
        ]
    },
    {
        "id": "rule_archive_content_01",
        "category": "Archive",
        "priority": 1,
        "type": "keyword",
        "patterns": [
            "Archive Contents",
            "ZIP Archive",
            "RAR Archive"
        ]
    },
    {
        "id": "rule_digital_cert_name_01",
        "category": "Digital Certificate",
        "priority": 2,
        "type": "regex",
        "patterns": [
            "\\A(?:filename:)?[^\\n]*\\.(?:cer|csi)\\b"
        ]
    },
    {
        "id": "rule_digital_cert_content_01",
